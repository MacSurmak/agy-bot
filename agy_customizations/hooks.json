{
  "enforce-native-file-tools": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|write_file|edit_file|schedule",
        "hooks": [
          {
            "type": "command",
            "command": "/srv/antigravity/venv/bin/python -m antigravity_core.hooks.enforce_native_edit",
            "timeout": 960
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_file|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "/srv/antigravity/venv/bin/python -m antigravity_core.hooks.enforce_native_edit --post",
            "timeout": 960
          }
        ]
      }
    ]
  }
}
