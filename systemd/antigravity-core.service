[Unit]
Description=Antigravity Telegram Core (MTProto Orchestrator & Warm Worker Pool)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=agy-agent
WorkingDirectory=/opt/antigravity/app
RuntimeDirectory=agy
RuntimeDirectoryMode=0750
Environment="ANTIGRAVITY_CONFIG=/etc/antigravity-core/config.yaml"
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=/usr/bin/docker compose --project-name app --env-file /etc/antigravity-core/.env -f /opt/antigravity/app/docker-compose.yml up -d --wait
ExecStartPre=/opt/antigravity/venv/bin/alembic -c /opt/antigravity/app/alembic.ini upgrade head
ExecStart=/opt/antigravity/venv/bin/python -m antigravity_core.main
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
